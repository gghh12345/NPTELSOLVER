{
  "manifest_version": 3,
  "name": "NPTEL Pro Solver - Assignment & Quiz AI",
  "version": "1.0.0",
  "description": "Smart assignment companion for NPTEL & Swayam courses featuring official question bank matching and multimodal AI reasoning.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "NPTEL Pro Solver"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.nptel.ac.in/*",
    "https://onlinecourses.nptel.ac.in/*",
    "https://swayam.gov.in/*",
    "https://*.swayam.gov.in/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.workers.dev/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.nptel.ac.in/*",
        "https://onlinecourses.nptel.ac.in/*",
        "https://swayam.gov.in/*",
        "https://*.swayam.gov.in/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "file:///*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open NPTEL Pro Solver Side Panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://generativelanguage.googleapis.com https://*.workers.dev https://*.nptel.ac.in https://*.swayam.gov.in http://localhost:* http://127.0.0.1:*;"
  }
}
